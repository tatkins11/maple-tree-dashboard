---
import Base from '../layouts/Base.astro';
import TableSort from '../components/TableSort.astro';
import race from '../data/seed_race.json';
import { rate, int, dec1, diff } from '../lib/fmt';

const teams: any[] = race.teams;
const us: any = teams.find((t) => t.is_team);
const leader: any = teams[0];
const ourGames: any[] = race.remaining.filter((g: any) => g.involves_us);
const ourOdds: any[] = (race.our_seed_odds as any[]).filter((o) => o.p > 0.001);
const bestSeed = ourOdds.length ? ourOdds.reduce((a, b) => (b.p > a.p ? b : a)) : null;

/** Odds as a percent, but never round a live chance down to a flat "0%". */
const pct = (p: number) => {
  if (p <= 0) return '—';
  if (p < 0.001) return '<0.1%';
  return `${(p * 100).toFixed(1)}%`;
};
const aliveButLongshot = us.alive_for_top_seed && us.p_top_seed < 0.001;
const tb: any[] = (race as any).our_tiebreakers ?? [];
const held = tb.filter((t) => t.we_hold);
const lost = tb.filter((t) => !t.we_hold);
const scen: any[] = (race as any).scenarios ?? [];
const joint: any[] = (race as any).joint ?? [];
const rival: string = (race as any).rival ?? '';
const LBL: Record<number, string> = { 0: 'lose both', 1: 'split', 2: 'win both' };
const power: any[] = (race as any).power_ranking ?? [];
const projected: any[] = (race as any).projected_table ?? [];
const rooting: any[] = (race as any).rooting ?? [];
---

<Base
  title="Race for the #1 Seed — Maple Tree Softball"
  description="Every remaining Summer 2026 outcome enumerated exactly: who can still take the top seed, what Maple Tree needs, and the games that decide it."
>
  <h1 class="page-title">Race for the #1 Seed</h1>
  <p class="page-sub">
    Every one of the {race.branches.toLocaleString()} ways the rest of the season can play out,
    counted exactly — not sampled. {race.games_remaining} games left.
  </p>

  <!-- the headline -->
  <section class="race-hero">
    <div class="race-hero-main">
      <div class="rh-kicker">Maple Tree sit</div>
      <div class="rh-seed">#{us.seed}</div>
      <div class="rh-rec">{int(us.wins)}-{int(us.losses)} · {diff(us.run_diff)} run diff</div>
    </div>
    <div class="race-hero-split">
      <div class="rh-stat">
        <div class="rh-v rh-hot">{pct(us.p_top_seed)}</div>
        <div class="rh-l">chance at the #1 seed</div>
      </div>
      <div class="rh-stat">
        <div class="rh-v">{pct(us.p_first_round_bye)}</div>
        <div class="rh-l">chance of a first-round bye</div>
      </div>
      <div class="rh-stat">
        <div class="rh-v">#{bestSeed ? bestSeed.seed : us.seed}</div>
        <div class="rh-l">most likely finish</div>
      </div>
    </div>
  </section>

  <!-- what seeding actually buys -->
  <section class="race-block">
    <h2 class="sec-title">What the seed actually buys</h2>
    <p class="sec-sub">
      Every club makes the playoffs and all ten games are Wednesday 19 August, so this was
      never a race to get in. Seeds 1 through 5 skip the 6:30 play-in round — and at
      {pct(us.p_first_round_bye)} that bye is effectively already ours. What is still live is
      which half of the bracket we land in.
    </p>
    <div class="bracket-halves">
      <div class="bh">
        <div class="bh-head">Top half</div>
        <div class="bh-seeds">#1 · #4 · #5 <span class="bh-plus">+ the 8/9 winner</span></div>
        <p class="bh-note">
          #4 and #5 open against each other and the winner draws #1 in the semi-final.
          Landing here means going through the best team in the league to reach the final.
        </p>
      </div>
      <div class="bh">
        <div class="bh-head">Bottom half</div>
        <div class="bh-seeds">#2 · #3 <span class="bh-plus">+ the 7/10 and 6/11 winners</span></div>
        <p class="bh-note">
          #3 rides with #2 and cannot meet #1 before the final. That is why the step from
          #3 to #4 is the most expensive one left on the board — bigger than the step from
          #2 to #3.
        </p>
      </div>
    </div>
  </section>

  {
    aliveButLongshot && (
      <p class="race-callout">
        <strong>Alive, but only just.</strong> A branch exists where Maple Tree finish on top —
        win both against {leader.team}, and have {teams[1].team} drop both to a winless club. It
        happens in fewer than one run of the season in a thousand. The realistic fight is for
        seeding behind the leaders, and it is genuinely close.
      </p>
    )
  }

  <!-- tiebreakers -->
  <section class="race-block">
    <h2 class="sec-title">The tiebreakers we already own</h2>
    <p class="sec-sub">
      Two clubs tied: head-to-head record, then fewest runs allowed against that club, then
      fewest runs allowed overall. Three or more tied: best head-to-head win percentage — and a
      club must have beaten <em>every</em> other tied club at least once to be ranked on it — then
      fewest average runs allowed within the group. Overall run differential never enters it, so
      the +26 on the standings page decides nothing.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th>Opponent</th><th class="num">Series</th><th class="num">Runs</th><th class="num">Runs allowed</th><th>Tiebreak</th></tr>
        </thead>
        <tbody>
          {
            tb.map((t: any) => (
              <tr>
                <td>{t.opponent}</td>
                <td class="num">{t.w}-{t.l}</td>
                <td class="num">{t.runs_for}-{t.runs_against}</td>
                <td class="num">{t.runs_against}</td>
                <td>
                  <span class:list={['tb-tag', t.we_hold ? 'tb-win' : 'tb-lose']}>
                    {t.we_hold ? 'Maple Tree' : t.opponent}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="sec-sub" style="margin-top:10px">
      {held.length > 0 && `We win a tie with ${held.map((t) => t.opponent).join(', ')}. `}
      {lost.length > 0 && (
        <><strong>We lose one to {lost.map((t) => t.opponent).join(', ')}</strong> — and that is the
        tie most likely to matter, because Brew Crew have four games left against the bottom of the
        table while we have two against the top.</>
      )}
    </p>
  </section>

  <!-- what our own two games do -->
  <section class="race-block">
    <h2 class="sec-title">Our last two games</h2>
    <p class="sec-sub">
      Both against {ourGames.length ? (ourGames[0].home === 'Maple Tree' ? ourGames[0].away : ourGames[0].home) : '—'} —
      the team directly ahead of us. Nobody else in the league finishes against a tougher opponent.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th>Week</th><th>Matchup</th><th class="num">Our win odds</th></tr>
        </thead>
        <tbody>
          {
            ourGames.map((g: any) => {
              const home = g.home === 'Maple Tree';
              const p = home ? g.home_win_prob : 1 - g.home_win_prob;
              return (
                <tr>
                  <td>{g.week}</td>
                  <td>{home ? `vs ${g.away}` : `at ${g.home}`}</td>
                  <td class="num">{pct(p)}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- the three ways it goes -->
  <section class="race-block">
    <h2 class="sec-title">The three ways our doubleheader goes</h2>
    <p class="sec-sub">
      Both our games are coin flips here — Brian's call, and a fairer planning assumption than
      the model's read of a two-game sample. Everyone else's games keep their modelled odds.
      Each column below is conditional: given that this is how our night goes, here is where
      we land.
    </p>
    <div class="scen-grid">
      {
        scen.map((sc: any) => (
          <div class:list={['scen', { 'scen-best': sc.wins === 2 }]}>
            <div class="scen-head">
              <span class="scen-label">{sc.label}</span>
              <span class="scen-rec">{sc.final_record}</span>
            </div>
            <div class="scen-seed">
              #{sc.likeliest_seed}
              <span class="scen-seed-l">most likely seed</span>
            </div>
            <div class="scen-rows">
              {
                sc.seeds.map((x: any) => (
                  <div class="scen-row">
                    <span class="sr-seed">#{x.seed}</span>
                    <span class="sr-track">
                      <span class="sr-fill" style={`width:${Math.max(x.p * 100, 1)}%`} />
                    </span>
                    <span class="sr-val">{pct(x.p)}</span>
                  </div>
                ))
              }
            </div>
            <div class="scen-foot">
              <div><span>Bye</span><strong>{pct(sc.p_bye)}</strong></div>
              <div>
                <span>#2 or better</span>
                <strong class="hot">
                  {pct(sc.seeds.filter((x: any) => x.seed <= 2).reduce((a: number, x: any) => a + x.p, 0))}
                </strong>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <p class="sec-sub" style="margin-top:12px">
      <strong>The bye is only at risk if we lose both.</strong> Win one and it is locked at 100%.
      Lose both and there is a {scen.length ? pct(scen[0].seeds.filter((x: any) => x.seed >= 6).reduce((a: number, x: any) => a + x.p, 0)) : '—'} chance
      we slide to sixth and have to play the 6:30 game. <strong>Sweep and we take the second seed
      in ninety-four outcomes out of a hundred</strong>, with a floor of third — the half of the
      bracket that cannot meet Wasted Talent before the final. Split and the bye holds, but second
      is effectively gone: Sandlot Vibes finish against the only winless club in the league.
    </p>
  </section>

  <!-- where we actually land -->
  <section class="race-block">
    <h2 class="sec-title">Where Maple Tree finish</h2>
    <p class="sec-sub">
      Share of all {race.branches.toLocaleString()} outcomes that end with us on each seed.
      {bestSeed && ` Most likely: #${bestSeed.seed}.`}
    </p>
    <div class="seed-bars">
      {
        ourOdds.map((o: any) => (
          <div class="seed-bar-row">
            <span class="sb-seed">#{o.seed}</span>
            <span class="sb-track">
              <span
                class:list={['sb-fill', { 'sb-best': bestSeed && o.seed === bestSeed.seed }]}
                style={`width:${Math.max(o.p * 100, 0.6)}%`}
              />
            </span>
            <span class="sb-val">{pct(o.p)}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- the two-body problem -->
  {
    joint.length > 0 && (
      <section class="race-block">
        <h2 class="sec-title">What it takes: our night and {rival}'s</h2>
        <p class="sec-sub">
          The seed race is really a two-body problem. Our own result only gets us so far — the
          rest depends on whether the club a game ahead of us drops anything to a winless side.
          We hold the head-to-head over {rival}, so a tie goes our way.
        </p>
        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr>
                <th>Maple Tree</th>
                <th>{rival}</th>
                <th class="num">Chance</th>
                <th class="num">#2 or better</th>
                <th class="num">Likeliest seed</th>
              </tr>
            </thead>
            <tbody>
              {
                joint.map((j: any) => {
                  const good = j.p_seed_2_or_better > 0.2;
                  const top = j.seeds.length
                    ? j.seeds.reduce((a: any, b: any) => (b.p > a.p ? b : a))
                    : null;
                  return (
                    <tr class:list={[{ 'is-us': good }]}>
                      <td>{LBL[j.our_wins]}</td>
                      <td>{LBL[j.rival_wins]}</td>
                      <td class="num">{pct(j.p)}</td>
                      <td class:list={['num', { tit: good }]}>{pct(j.p_seed_2_or_better)}</td>
                      <td class="num">{top ? `#${top.seed}` : '—'}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
        <p class="sec-sub" style="margin-top:10px">
          <strong>Two live paths to the second seed, both requiring help:</strong> sweep the
          doubleheader and have {rival} drop one, or split it and have them drop both. The catch is
          that their last two are against the only winless club in the league — which is why the
          unconditional number looks so thin.
        </p>
      </section>
    )
  }

  <!-- rooting guide -->
  <section class="race-block">
    <h2 class="sec-title">Who to root for in everyone else's games</h2>
    <p class="sec-sub">
      For each game we are not playing, the club whose win lowers our expected seed.
      Several of these <em>invert</em> depending on how our own doubleheader goes, so the
      column that applies is the one matching our result — a single blanket answer would
      point the wrong way about half the time.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th>Matchup</th>
            <th>If we win both</th>
            <th>If we split</th>
            <th>If we lose both</th>
            <th class="num">Leverage</th>
          </tr>
        </thead>
        <tbody>
          {
            rooting.map((r: any) => (
              <tr class:list={[{ 'is-dead': r.max_swing < 0.005 }]}>
                <td>
                  {r.home} vs {r.away}
                  {r.unconditional && <span class="uncond-tag">same either way</span>}
                </td>
                {['win_both', 'split', 'lose_both'].map((k) => (
                  <td>
                    {r.by_scenario[k].root_for ? (
                      <span class:list={['root-pill', { 'root-us': false }]}>
                        {r.by_scenario[k].root_for}
                      </span>
                    ) : (
                      <span class="root-none">no effect</span>
                    )}
                  </td>
                ))}
                <td class="num">{r.max_swing < 0.005 ? '—' : r.max_swing.toFixed(2)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="sec-sub" style="margin-top:10px">
      Leverage is how far our expected seed moves between the two results, in seed
      positions. Two of these flip for the same reason: a third club joining a tie can
      rescue us, because the three-way rule demands a win over <em>every</em> other tied
      club and we are often the only side that has one.
    </p>
  </section>

  <!-- power ranking -->
  <section class="race-block">
    <h2 class="sec-title">Power ranking</h2>
    <p class="sec-sub">
      Records flatter some clubs and punish others, so this solves for the per-team
      strength that best explains all {race.games_played} results at once — schedule is
      adjusted for by construction, not bolted on. Ratings read as runs per game better
      than an average club. Blowouts are capped at {race.massey.cap}; the ordering holds
      across every cap from 8 to uncapped. The fit explains {(race.massey.r2 * 100).toFixed(0)}%
      of margin, and home advantage came out at {race.massey.home_edge.toFixed(2)} runs — nothing,
      which is what you would expect when every game is at the same complex.
    </p>
    <div class="tbl-wrap">
      <table class="tbl" data-sortable>
        <thead>
          <tr>
            <th class="num rank" data-nosort>#</th>
            <th>Team</th>
            <th class="num">W</th>
            <th class="num">L</th>
            <th class="num">Diff</th>
            <th class="num">SOS</th>
            <th class="num">Rating</th>
            <th>vs record</th>
          </tr>
        </thead>
        <tbody>
          {
            power.map((r: any) => (
              <tr class:list={[{ 'is-us': r.is_team }]}>
                <td class="num rank">{r.rank}</td>
                <td>{r.team}{r.is_team ? ' 🍁' : ''}</td>
                <td class="num">{int(r.wins)}</td>
                <td class="num">{int(r.losses)}</td>
                <td class="num" data-v={String(r.run_diff)}>{diff(r.run_diff)}</td>
                <td class="num" data-v={String(r.sos_played)}>{r.sos_played.toFixed(3)}</td>
                <td class="num" data-v={String(r.rating)}>
                  <strong>{r.rating > 0 ? '+' : ''}{r.rating.toFixed(2)}</strong>
                </td>
                <td>
                  {r.move === 0 ? (
                    <span class="mv-same">—</span>
                  ) : (
                    <span class:list={['mv', r.move > 0 ? 'mv-up' : 'mv-down']}>
                      {r.move > 0 ? `▲ ${r.move}` : `▼ ${-r.move}`}
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="sec-sub" style="margin-top:10px">
      SOS is opponents' projected final win percentage, each opponent measured excluding
      their games against the club being rated. Ours is the toughest in the league.
    </p>
  </section>

  <!-- projected final table -->
  <section class="race-block">
    <h2 class="sec-title">Projected final table</h2>
    <p class="sec-sub">
      Each club's most likely finishing seed and record, with the spread behind it.
      These are per-club modes, so they need not form a single valid table — two clubs
      can both be likeliest in the same slot.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th class="num rank" data-nosort>Seed</th><th>Team</th><th class="num">Record</th><th class="num">Odds</th><th>Spread</th></tr>
        </thead>
        <tbody>
          {
            projected.map((r: any) => (
              <tr class:list={[{ 'is-us': r.is_team }]}>
                <td class="num rank">{r.seed}</td>
                <td>{r.team}{r.is_team ? ' 🍁' : ''}</td>
                <td class="num">{r.record}</td>
                <td class="num">{pct(r.seed_confidence)}</td>
                <td class="spread-cell">
                  {r.spread.map((s: any) => (
                    <span class:list={['spr', { 'spr-top': s.seed === r.seed }]}>
                      #{s.seed} {(s.p * 100).toFixed(0)}%
                    </span>
                  ))}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- full board -->
  <section class="race-block">
    <h2 class="sec-title">The full board</h2>
    <p class="sec-sub">
      Sorted by current seed. <strong>Max</strong> is the best record still reachable;
      once that cannot beat the leaders, a team is out.
    </p>
    <div class="tbl-wrap">
      <table class="tbl" data-sortable>
        <thead>
          <tr>
            <th class="num rank" data-nosort>Seed</th>
            <th>Team</th>
            <th class="num">W</th>
            <th class="num">L</th>
            <th class="num">Pct</th>
            <th class="num">RS/G</th>
            <th class="num">RA/G</th>
            <th class="num">Left</th>
            <th class="num">Max</th>
            <th class="num">#1 seed</th>
            <th class="num">Bye</th>
          </tr>
        </thead>
        <tbody>
          {
            teams.map((t: any) => (
              <tr class:list={[{ 'is-us': t.is_team, 'is-out': !t.alive_for_top_seed }]}>
                <td class="num rank">{t.seed}</td>
                <td>
                  {t.team}
                  {t.is_team ? ' 🍁' : ''}
                  {!t.alive_for_top_seed && <span class="out-tag">out of the #1 race</span>}
                </td>
                <td class="num">{int(t.wins)}</td>
                <td class="num">{int(t.losses)}</td>
                <td class="num" data-v={String(t.win_pct)}>{rate(t.win_pct)}</td>
                <td class="num" data-v={String(t.rs_per_game)}>{dec1(t.rs_per_game)}</td>
                <td class="num" data-v={String(t.ra_per_game)}>{dec1(t.ra_per_game)}</td>
                <td class="num">{int(t.games_left)}</td>
                <td class="num">{int(t.max_wins)}</td>
                <td class="num tit" data-v={String(t.p_top_seed)}>{pct(t.p_top_seed)}</td>
                <td class="num" data-v={String(t.p_first_round_bye)}>{pct(t.p_first_round_bye)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- everything still to play -->
  <section class="race-block">
    <h2 class="sec-title">Every game left in the league</h2>
    <p class="sec-sub">Odds are for the home side. Ours are highlighted.</p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th>Week</th><th>Home</th><th>Away</th><th class="num">Home win odds</th></tr>
        </thead>
        <tbody>
          {
            race.remaining.map((g: any) => (
              <tr class:list={[{ 'is-us': g.involves_us }]}>
                <td>{g.week}</td>
                <td>{g.home}</td>
                <td>{g.away}</td>
                <td class="num">{pct(g.home_win_prob)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <p class="table-note">{race.bracket_note}</p>
  <p class="table-note">{race.method}</p>

  <TableSort />
</Base>

<style>
  .race-hero {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 22px;
    align-items: center;
    background: var(--card, #f8f7f2);
    border: 1px solid var(--line, #d8d3c2);
    border-radius: 14px;
    padding: 20px 22px;
    margin-bottom: 20px;
  }
  .rh-kicker {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted, #77705f);
  }
  .rh-seed { font-size: 62px; font-weight: 800; line-height: 1; color: var(--maple, #c2410c); }
  .rh-rec { font-size: 13px; color: var(--muted, #77705f); margin-top: 4px; }
  .race-hero-split { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .rh-v { font-size: 27px; font-weight: 800; line-height: 1.1; }
  .rh-v.rh-hot { color: var(--maple, #c2410c); }
  .rh-l { font-size: 11.5px; color: var(--muted, #77705f); margin-top: 4px; }

  .race-callout {
    border-left: 3px solid var(--maple, #c2410c);
    background: rgba(194, 65, 12, 0.06);
    padding: 12px 16px;
    border-radius: 0 8px 8px 0;
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 26px;
  }

  .race-block { margin-bottom: 30px; }
  .sec-title { font-size: 19px; margin: 0 0 4px; }

  .root-pill {
    display: inline-block;
    background: rgba(21, 128, 61, 0.1);
    border: 1px solid rgba(21, 128, 61, 0.3);
    color: #14532d;
    border-radius: 99px;
    padding: 2px 9px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .root-none { color: var(--muted, #77705f); font-size: 12px; font-style: italic; }
  tr.is-dead td { opacity: 0.5; }
